# Copiar a .env y ajustar. El .env real no se versiona.

NODE_ENV=development
PORT=3000

# PostgreSQL 18 local
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/transportes?schema=public"

# Firma de los JWT. En producción debe ser un secreto largo y aleatorio.
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=cambiar-tambien-este
JWT_REFRESH_EXPIRES_IN=7d

# Origen permitido para el cliente Angular
CORS_ORIGIN=http://localhost:4200

# GraphQL: el playground se sirve sólo fuera de producción
GRAPHQL_PLAYGROUND=true
